{
  "name": "nixie-clock-companion",
  "productName": "Nixie Clock Companion",
  "version": "1.0.0",
  "description": "Offline build guide, calculators and USB serial companion for the Six-Tube Nixie Clock (Rev C, unvalidated prototype).",
  "homepage": "https://github.com/Normansrule/nixie-clock",
  "author": "Aleksander Norman",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "copy-site": "node copy-site.js",
    "start": "node copy-site.js && electron .",
    "dist": "node copy-site.js && electron-builder --publish never",
    "dist:linux": "node copy-site.js && electron-builder --linux --publish never",
    "dist:win": "node copy-site.js && electron-builder --win --publish never",
    "dist:mac": "node copy-site.js && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.nixieclock.companion",
    "artifactName": "NixieClockCompanion-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "www/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "deb": {
      "maintainer": "Aleksander Norman"
    },
    "publish": null
  }
}
